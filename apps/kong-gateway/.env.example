# Kong Gateway — environment variable reference
# Copy to .env and fill in values before running locally.
# DO NOT commit .env to version control.

# ── Session store (PostgreSQL) ─────────────────────────────────────────────────
GATEWAY_DB_HOST=my-db
GATEWAY_DB_PORT=5432
GATEWAY_DB_NAME=gateway-service
GATEWAY_DB_USER=gateway-service_user
GATEWAY_DB_PASSWORD=12345678   # dev only — rotate via GCP Secret Manager in prod

# ── Rate limiting ──────────────────────────────────────────────────────────────
GATEWAY_RATE_LIMIT_MINUTE=100  # requests per minute per IP (global)

# ── Kong process ───────────────────────────────────────────────────────────────
KONG_DATABASE=off
KONG_DECLARATIVE_CONFIG=/etc/kong/kong.yml
KONG_PLUGINS=bundled,session-identity,dynamic-router
KONG_ADMIN_LISTEN=0.0.0.0:8001
KONG_PROXY_LISTEN=0.0.0.0:8000
KONG_LOG_LEVEL=info

# ── User deletion shared secret (GDPR Art. 17 erasure endpoint) ───────────────
GATEWAY_ADMIN_SECRET=change-me-in-prod
