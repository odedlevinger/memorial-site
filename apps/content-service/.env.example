# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Instance: my-db  |  Database: content-service  |  User: content-service_user
# Password for local dev is 12345678 — rotate via GCP Secret Manager in prod.
DATABASE_URL=postgres://content-service_user:12345678@my-db:5432/content-service

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3002

# ── Access control ────────────────────────────────────────────────────────────
# Owners (comma-separated Google account emails) — can manage editors; never locked out.
OWNER_EMAILS=oded.levinger@gmail.com
# auth-service internal admin API, used to map Kong's X-User-Id → email.
AUTH_SERVICE_URL=http://auth-service:3001
ADMIN_SECRET=change-me-in-production
# true on Cloud Run: call the private auth-service with a Google ID token.
AUTH_SERVICE_IAM=false

# ── Image storage ─────────────────────────────────────────────────────────────
# Set STORAGE_BUCKET in production (Cloud Storage, public-read objects).
# Without it, images go to STORAGE_LOCAL_DIR and are served at /content/files.
STORAGE_BUCKET=
STORAGE_LOCAL_DIR=/tmp/content-files
STORAGE_PUBLIC_BASE=http://localhost:8000/content-service/content/files

# ── Placeholder import (SPEC §5) ──────────────────────────────────────────────
# Web origin serving /gallery/galleries.json; imported once into an empty database.
SEED_SOURCE_URL=http://web

# ── Activity chart ────────────────────────────────────────────────────────────
# Time zone whose calendar days the back-office activity chart counts (default Asia/Jerusalem).
SITE_TIME_ZONE=Asia/Jerusalem
