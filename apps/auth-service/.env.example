# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Instance: my-db  |  Database: auth-service  |  User: auth-service_user
# Password for local dev is 12345678 — rotate via GCP Secret Manager in prod.
DATABASE_URL=postgres://auth-service_user:12345678@my-db:5432/auth-service

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-in-production

# ── Admin (internal service-to-service) ──────────────────────────────────────
ADMIN_SECRET=change-me-in-production

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Google OAuth 2.0 ─────────────────────────────────────────────────────────
# Web OAuth client — used by the web app's /oauth/callback flow.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Optional iOS-specific Google OAuth client. When the request carries
# X-Client-Platform: mobile and these are set, the auth-service exchanges
# the code with the iOS client (no client_secret — public PKCE client) and
# the matching custom URI scheme. If unset, the mobile path falls back to
# the web client config above (preserves single-client setups).
GOOGLE_IOS_CLIENT_ID=
GOOGLE_IOS_REDIRECT_URI=
