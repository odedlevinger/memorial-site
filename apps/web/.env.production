# Web build-time env (Vite). The deploy workflow injects VITE_GOOGLE_CLIENT_ID as a
# build-arg at image build time; this placeholder is for local production builds.
# The client id is a public OAuth Web client id (safe to commit). API calls go
# same-origin to /api/auth, proxied to Kong by nginx (see nginx.conf.template).
VITE_GOOGLE_CLIENT_ID=630004946962-4jbeq6m10iffevmk2o4vvi19hkdcfhat.apps.googleusercontent.com
