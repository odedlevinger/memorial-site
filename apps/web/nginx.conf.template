# Link-preview tags and site text (see /share-meta, /site-summary below): cached so a cold
# content-service never holds up the page.
proxy_cache_path /var/cache/nginx/share-meta levels=1 keys_zone=share_meta:1m max_size=1m inactive=1d use_temp_path=off;

server {
  listen 80;
  root /usr/share/nginx/html;
  index index.html;
  client_max_body_size 50m;

  # Auth API proxied through the Kong gateway (the sole public entry point).
  # The new business domain adds further /api/* proxy blocks here as needed.
  location /api/auth {
    proxy_pass ${AUTH_SERVICE_URL}/auth-service/auth;
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # Memory content API (public reads + back office) through Kong → content-service.
  location /api/content {
    proxy_pass ${AUTH_SERVICE_URL}/content-service/content;  # AUTH_SERVICE_URL is the Kong URL (only var substituted)
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 300s;
  }

  # Title, tagline and share picture as <head> tags, included into index.html by SSI
  # (internal: only reachable as a subrequest). A slow or failed fetch serves the last
  # good copy, or index.html's fallback <title> when there is none yet.
  location = /share-meta {
    internal;
    proxy_pass ${AUTH_SERVICE_URL}/content-service/content/public/share-meta;
    proxy_set_header Host $proxy_host;
    proxy_set_header Accept-Encoding "";
    proxy_connect_timeout 3s;
    proxy_read_timeout 5s;
    proxy_cache share_meta;
    proxy_cache_key share-meta;
    proxy_cache_valid 200 1m;
    proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
    proxy_cache_background_update on;
    proxy_cache_lock on;
  }

  # The site text as plain HTML, included into index.html's #root by SSI so web filters
  # and other readers that don't run JavaScript see real content (React replaces it).
  location = /site-summary {
    internal;
    proxy_pass ${AUTH_SERVICE_URL}/content-service/content/public/site-summary;
    proxy_set_header Host $proxy_host;
    proxy_set_header Accept-Encoding "";
    proxy_connect_timeout 3s;
    proxy_read_timeout 5s;
    proxy_cache share_meta;
    proxy_cache_key site-summary;
    proxy_cache_valid 200 1m;
    proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
    proxy_cache_background_update on;
    proxy_cache_lock on;
  }

  # Hashed build assets must 404 (not fall back to index.html) when missing.
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  location / {
    ssi on;  # index.html includes /share-meta and /site-summary
    add_header Cache-Control "no-cache";
    try_files $uri $uri/ /index.html;
  }
}
